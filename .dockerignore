# Docker 构建上下文白名单：默认排除一切，只放行推理镜像所需文件。
*

# 推理端代码与服务
!inference/
!service/
!deploy/
inference/__pycache__/
inference/logs/
inference/result*.json
service/__pycache__/

# 模型目录里只保留 Paddle 部署权重（训练 checkpoint、ONNX 探索产物不进镜像）
!models/
models/*
!models/finetuned/
!models/vehicle/
models/finetuned/*
!models/finetuned/person_detector/
!models/finetuned/person_attribute/
!models/finetuned/face_mask/
models/finetuned/person_attribute/*
!models/finetuned/person_attribute/inference.json
!models/finetuned/person_attribute/inference.pdiparams
models/finetuned/face_mask/*
!models/finetuned/face_mask/face_mask_detection.onnx
!models/finetuned/face_mask/synset.txt
models/vehicle/*
!models/vehicle/mot_ppyoloe_s_36e_ppvehicle/
!models/vehicle/vehicle_attribute_model/
!models/vehicle/.hyperlpr3/
models/vehicle/mot_ppyoloe_s_36e_ppvehicle/SOURCE.md
models/vehicle/vehicle_attribute_model/SOURCE.md
